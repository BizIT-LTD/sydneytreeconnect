# Sydney Tree Connect enquiry form configuration (EXAMPLE ONLY: dummy values)
#
# Copy this file OUTSIDE the web root, for example on Hostinger:
#   /home/<user>/domains/sydneytreeconnect.com/private/stc-enquiry.env
# api/enquiry.php reads that path automatically, or the path in the
# STC_ENV_FILE environment variable. Never upload the real file into
# public_html and never commit it.

# Set to true only when everything below is configured and tested.
ENQUIRY_ENABLED=false

# Owner's enquiry inbox (comma-separate for more than one). Not the contractor.
ENQUIRY_TO=enquiries-inbox@example.com
ENQUIRY_TO_NAME=Sydney Tree Connect enquiries

# Sender. With Gmail SMTP this must be the same Gmail address as SMTP_USER.
MAIL_FROM=website@example.com
MAIL_FROM_NAME=Sydney Tree Connect website

# Authenticated SMTP.
#   Gmail (current setup): smtp.gmail.com, port 465, ssl (or 587, tls);
#     SMTP_USER is the Gmail address and SMTP_PASS is a Google App Password
#     (16 letters, spaces optional), never the normal Gmail password.
#   Hostinger mailbox:     smtp.hostinger.com, port 465, ssl.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
# ssl (port 465), tls (STARTTLS, port 587) or none (local testing only)
SMTP_SECURE=ssl
SMTP_USER=website@example.com
SMTP_PASS=replace-with-app-password

# Browsers must post from one of these origins.
ALLOWED_ORIGINS=https://sydneytreeconnect.com,https://www.sydneytreeconnect.com

# Rate limiting. The secret is used to hash IP addresses; use 32+ random characters.
RATE_LIMIT_SECRET=replace-with-a-long-random-string
# Defaults to a stc-rate-limit folder next to this env file.
# RATE_LIMIT_DIR=/home/<user>/domains/sydneytreeconnect.com/private/stc-rate-limit
RATE_LIMIT_PER_HOUR=5
RATE_LIMIT_PER_DAY=15
RATE_LIMIT_GLOBAL_PER_DAY=200

# Photo limits in bytes (cannot be raised above 4 MB each / 12 MB total
# without also changing the handler, the form text and assets/js/main.js).
MAX_PHOTO_BYTES=4194304
MAX_TOTAL_PHOTO_BYTES=12582912
